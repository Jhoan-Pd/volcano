# ── Backend: copy this file to .env and adjust the values ──────────────────────
ENV=development

# Database
#  - Quick local run (nothing to install):  sqlite:///./dev.db
#  - Local PostgreSQL:                      postgresql://postgres:postgres@localhost:5432/volcano
#  - Neon (recommended in the cloud):       postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# Security (generate long random values: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
CRON_SECRET=change-me-cron-secret
# Shared by the gateway, the engine and the realtime hub (gRPC metadata and internal events)
INTERNAL_TOKEN=change-me-internal-token

# CORS: frontend origins, comma-separated (no trailing /). The realtime hub uses them to check the
# Origin of WebSocket connections too.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: regex for Vercel preview URLs
# CORS_ORIGIN_REGEX=https://volcano-.*\.vercel\.app

# Administrator created by the seed
ADMIN_EMAIL=admin@predictor.co
ADMIN_PASSWORD=Admin2026*
ADMIN_NAME=Administrador
# Password of the demo users farmacia@demo.co and ciudadano@demo.co
DEMO_PASSWORD=Demo2026*

# Open-Meteo: true = the seed downloads the REAL historical weather (2019-today)
SEED_REAL_WEATHER=true
SEED_START_YEAR=2020

# Google Trends (pytrends). When Google blocks the query the database cache and the CSVs in TRENDS_CSV_DIR are used
TRENDS_ENABLED=true
TRENDS_REGION=CO-NAR
TRENDS_CSV_DIR=data/trends

# SIVIGILA on datos.gov.co (Socrata). The token is optional (https://www.datos.gov.co/profile/edit/developer_settings)
SOCRATA_URL=https://www.datos.gov.co/resource/4hyg-wa9d.json
# SOCRATA_APP_TOKEN=
SIVIGILA_DEPARTMENT=52

# Model: the engine trains in the background on start-up when there is no usable model
TRAIN_ON_STARTUP=true

# Microservices inside the container (loopback only)
ENGINE_GRPC_ADDRESS=127.0.0.1:50051
ENGINE_ALERT_POLL_S=10
REALTIME_INTERNAL_URL=http://127.0.0.1:8002

# E-mail alerts with Resend (optional). Create a free API key at https://resend.com
# With the test sender onboarding@resend.dev you can only e-mail your own Resend account.
# RESEND_API_KEY=re_xxxxxxxx
ALERT_EMAIL_RECIPIENTS=
# Registered citizens get their municipality's alerts (needs a verified domain in Resend)
ALERTS_TO_CITIZENS=true
FRONTEND_URL=http://localhost:3000
# On-demand revalidation of the frontend's ISR pages (same value in Vercel). Optional.
# REVALIDATE_SECRET=
