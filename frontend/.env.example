# URL pública del backend (FastAPI en Render), sin "/" final. La usan el navegador y el servidor de Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Secreto para POST /api/revalidar (revalidación bajo demanda de las páginas ISR). Debe ser igual a
# REVALIDAR_SECRET del backend. Opcional en desarrollo.
REVALIDAR_SECRET=
