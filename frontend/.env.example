# URL pública del backend (FastAPI en Render), sin "/" final. La usan el navegador y el servidor de Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Secreto para POST /api/revalidar (revalidación bajo demanda de las páginas ISR). Debe ser igual a
# REVALIDAR_SECRET del backend. Opcional en desarrollo.
REVALIDAR_SECRET=
# Opcional: clave de Google Maps JavaScript API para el mapa con relieve y satélite de Google.
# Restríngela en Google Cloud a tu dominio de Vercel (https://tu-sitio.vercel.app/*) y solo a
# «Maps JavaScript API». Sin clave (o si Google la rechaza) el mapa usa Leaflet con capas de Esri.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
