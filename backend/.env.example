# ── Backend: copia este archivo como .env y ajusta los valores ──────────────
ENV=development

# Base de datos
#  - Local rápido (sin instalar nada):  sqlite:///./dev.db
#  - PostgreSQL local:                  postgresql://postgres:postgres@localhost:5432/predictor
#  - Neon (recomendado en la nube):     postgresql://USUARIO:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#  - Supabase (usar "Session pooler"):  postgresql://postgres.REF:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./dev.db

# Seguridad (genera valores largos y aleatorios: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=480
CRON_SECRET=cambia-este-secreto-del-cron

# CORS: orígenes del frontend separados por coma (sin / al final)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcional: regex para las URLs de preview de Vercel
# CORS_ORIGIN_REGEX=https://predictor-brotes.*\.vercel\.app

# Usuario administrador que crea el seed
ADMIN_EMAIL=admin@predictor.co
ADMIN_PASSWORD=Admin2026*
ADMIN_NOMBRE=Administrador
# Contraseña de los usuarios demo farmacia@demo.co y ciudadano@demo.co
DEMO_PASSWORD=Demo2026*

# Open-Meteo: true = el seed intenta bajar el clima histórico REAL (2019-hoy)
SEED_CLIMA_REAL=true
SEED_ANIO_INICIO=2020
